{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/rsj/Desktop/BuptleSolution/.codex/hooks/protect-files.mjs'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_TOOL_INPUT_FILE_PATH\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/rsj/Desktop/BuptleSolution/.codex/hooks/check-design-tokens.mjs'"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/rsj/Desktop/BuptleSolution/.codex/hooks/check-story-exists.mjs'"
          }
        ]
      }
    ]
  }
}
